{
	"name": "pi-decide",
	"version": "0.3.1",
	"description": "Pi extension. A structured multi-question dialog the model puts to you — with an autopilot that answers it itself when nobody is around, so long unattended runs never block on a human decision.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"pi-coding-agent",
		"questionnaire",
		"ask-user-question",
		"autopilot",
		"autonomous",
		"unattended"
	],
	"license": "MIT",
	"author": "zeroicey",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zeroicey/pi-decide.git"
	},
	"homepage": "https://github.com/zeroicey/pi-decide#readme",
	"bugs": {
		"url": "https://github.com/zeroicey/pi-decide/issues"
	},
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"verify:package": "npm pack --dry-run --json"
	},
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "^1.3.27"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
